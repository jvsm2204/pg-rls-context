{
  "name": "pg-rls-context",
  "version": "0.1.0",
  "description": "Safe multi-tenant Row-Level Security context for node-postgres. Applies tenant settings transaction-local so they never leak across a connection pool.",
  "keywords": [
    "postgres",
    "postgresql",
    "rls",
    "row-level-security",
    "multi-tenant",
    "multitenancy",
    "pg",
    "node-postgres",
    "tenant"
  ],
  "license": "MIT",
  "author": "João Vitor Magalhães",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvsm2204/pg-rls-context.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
